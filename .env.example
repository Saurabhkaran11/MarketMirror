# Server
PORT=8787

# 30-minute MVP: these two keys make the research-to-persona loop work.
EXA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Optional: only add this if Exa + Gemini are already working.
# Configure this actor to accept startUrls.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify/website-content-crawler

# Optional final demo step: browser voice call. VAPI_PUBLIC_KEY is safe to return to the browser.
# Configure the Vapi assistant with an ElevenLabs voice in the Vapi dashboard.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# Optional: direct persona voice preview endpoint.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=